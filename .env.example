TZ=UTC
PORT=4444
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# --- Base de datos ---
# Instancia MySQL dedicada de este backend (ver scripts/db.sh).
# Corre en el puerto 3307 para no chocar con un MySQL de sistema en el 3306.

# Origenes permitidos por CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tienda
DB_PASSWORD=tu_password_aqui
DB_DATABASE=tienda_app

# --- Almacenamiento de imágenes (bucket S3-compatible) ---
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=tu-bucket
S3_ACCESS_KEY_ID=tid_...
S3_SECRET_ACCESS_KEY=tsec_...
# Opcional: dominio público propio del bucket, si lo tienes
S3_PUBLIC_URL=

REPORTS_TIMEZONE=America/Lima
