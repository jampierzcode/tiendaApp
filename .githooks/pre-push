#!/usr/bin/env bash
# Corre lo mismo que el despliegue antes de dejarte subir nada a GitHub.
# Saltárselo puntualmente: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

echo "▸ pre-push: comprobando tipos…"
npm run --silent typecheck

echo "▸ pre-push: compilando…"
node ace build >/dev/null

echo "▸ pre-push: todo correcto. Subiendo."
